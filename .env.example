DISCORD_TOKEN=your_discord_bot_token
DASHBOARD_PORT=25567

# Simple single-administrator setup:
DASHBOARD_PASSWORD=replace_with_a_long_unique_password

# Optional multi-user setup. When set, this replaces DASHBOARD_PASSWORD login.
# Keep the JSON on one line and use only admin or viewer roles.
# DASHBOARD_USERS=[{"username":"admin","password":"change-me","role":"admin"},{"username":"viewer","password":"change-me-too","role":"viewer"}]

# Dashboard sessions expire after this many hours (1-168).
DASHBOARD_SESSION_HOURS=8

# Optional but recommended. Changing it signs out every dashboard user.
DASHBOARD_SESSION_SECRET=replace_with_a_long_random_secret
